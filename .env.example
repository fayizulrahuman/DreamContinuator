# AI PROVIDERS — SERVER SIDE ONLY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# MongoDB Atlas connection string: SERVER ONLY. Never prefix with VITE_.
MONGODB_URI=
MONGODB_DB=dreamcontinuator

# Firebase Admin service account (Firebase console > Project settings > Service accounts)
# SERVER ONLY. The private key must include \n escapes inside a one-line string.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web config (public by design)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
